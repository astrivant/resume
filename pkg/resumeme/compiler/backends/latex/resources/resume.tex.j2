    \setlength{\linewidth}{\typeblockwidth}%
  \else%
    \ifnum\value{page}=1\clearpage\fi%
  \fi%
}%
\newcommand{\profileparagraph}[1]{%
  \par
  \profilesetwidth
  \setlength{\profileparagraphwidth}{\linewidth}%
  \ifprofileprogression\addtolength{\profileparagraphwidth}{\dimexpr-6mm-0.6pt\relax}\fi
  \sbox{\paragraphmeasure}{\parbox[t]{\profileparagraphwidth}{#1}}%
  % A header too tall to wrap retains the original column transition and its paragraph remeasurement.
  \ifprofilewrapping\else
    \ifdim\dimexpr\ht\paragraphmeasure+\dp\paragraphmeasure+\parskip+\baselineskip\relax<\typeblockheight
      \ifdim\dimexpr\ht\paragraphmeasure+\dp\paragraphmeasure+\parskip+\baselineskip\relax>\dimexpr\pagegoal-\pagetotal\relax
        \framebreak
        \setlength{\profileparagraphwidth}{\linewidth}%
        \ifprofileprogression\addtolength{\profileparagraphwidth}{\dimexpr-6mm-0.6pt\relax}\fi
        \sbox{\paragraphmeasure}{\parbox[t]{\profileparagraphwidth}{#1}}%
      \fi
    \fi
  \fi
  % Text stays in one frame: a paragraph can widen below the profile without leaving a paragraph-sized gap.
  \ifprofileprogression
    \stepcounter{profileparagraphid}%
    \begingroup
      \setlength{\leftskip}{\dimexpr6mm+0.6pt\relax}%
      \setlength{\linewidth}{\profileparagraphwidth}%
      % Start the rail after bullet indentation has been set, without starting its paragraph prematurely.
      \def\profileparagraphmark{%
        \let\profileparagraphmark\relax
        \tikz[remember picture,overlay]{%
          \coordinate (role-start-\arabic{profileparagraphid}) at (-3mm-0.3pt,\ht\paragraphmeasure);
        }%
      }%
      #1\par
    \endgroup
    % A zero-height mark records the paragraph's bottom without changing its baseline spacing.
    \profileraildepth=\prevdepth
    \nointerlineskip\hbox{\tikz[remember picture,overlay]{%
      \coordinate (role-end-\arabic{profileparagraphid}) at (3mm+0.3pt,0pt);
    }}%
    \prevdepth=\profileraildepth
    \edef\profilerailstart{role-start-\arabic{profileparagraphid}}%
    \ifnum\profilerailpage=\value{page}\relax
      \edef\profilerailstart{\profilerailprevious}%
    \fi
    % Freeze node identifiers before the shipout hook runs; vertices stay visible above these background rails.
    \edef\pendingprofilerail{\noexpand\AddToHookNext{shipout/background}{%
      \noexpand\drawprofilerail{\profilerailstart}{role-end-\arabic{profileparagraphid}}%
        {\profilerailopacity}{\the\dimexpr0.5\baselineskip\relax}}}%
    \pendingprofilerail
    \edef\profilerailprevious{role-end-\arabic{profileparagraphid}}%
    \profilerailpage=\value{page}
    \def\profilerailopacity{100}%
  \else
    #1\par
  \fi
}
((* else *))
\newcommand{\profileparagraph}[1]{%
  \par
  \ifnum\value{page}=1
    \sbox{\paragraphmeasure}{\parbox{\linewidth}{#1}}%
    % Include leading baseline space; underestimating it can overflow before framebreak and flush a second, nearly empty page.
    \ifdim\dimexpr\ht\paragraphmeasure+\dp\paragraphmeasure+\parskip+\baselineskip\relax<\textheight
      \ifdim\dimexpr\ht\paragraphmeasure+\dp\paragraphmeasure+\parskip+\baselineskip\relax>\dimexpr\pagegoal-\pagetotal\relax
        \framebreak
      \fi
    \fi
  \fi
  #1\par
}
((* endif *))
% Plain LinkedIn labels such as Projects introduce subsections, rather than continuing the preceding bullet.
% Give them subordinate emphasis and keep room for the first line of their following content.
\newcommand{\profilesubheading}[1]{%
  \par\addvspace{0.35\baselineskip}%
  \Needspace{2.5\baselineskip}%
  \profileparagraph{{\color{entryheading}\bfseries #1}}%
}
% Keep a company's linked logo beside its name, allowing long employer names to wrap within the remaining width.
\newcommand{\companyline}[2]{%
  \profileparagraph{%
    \begin{minipage}[c]{8mm}\centering #1\end{minipage}%
    \hspace{2mm}%
    \begin{minipage}[c]{\dimexpr\linewidth-10mm\relax}\raggedright #2\end{minipage}%
  }%
}
% Project affiliation logos share the surrounding text's scale and keep their natural aspect ratio.
\newcommand{\inlinecompanylogo}[1]{%
  \raisebox{-0.15em}{\includegraphics[width=1.1em,height=1.1em,keepaspectratio]{#1}}%
}
% Each project company gets a fixed logo slot beside a wrapping name and subordinate role titles.
% Keep the row together so a long name stays aligned within either project column.
\newcommand{\projectcompany}[3]{%
  \profileparagraph{%
    \begin{minipage}[t]{4mm}\vspace{0pt}\centering #1\end{minipage}%
    \hspace{1.5mm}%
    \begin{minipage}[t]{\dimexpr\linewidth-5.5mm\relax}%
      \vspace{0pt}\raggedright\setlength{\parskip}{1pt}%
      \companytext{#2}\par
      {\small #3}%
    \end{minipage}%
  }%
}
% Normalize every recognized marker to one print bullet, with hanging alignment for wrapped and nested items.
% Each item remains a paragraph so it can use the existing flow-frame pagination and width measurements.
\newcommand{\profilebullet}[2]{%
  % TeX resets hanging indentation after the paragraph; leave flow-frame changes outside a temporary formatting group.
  \profileparagraph{%
    \hangindent=\dimexpr#1em+1em\relax\hangafter=1
    \noindent\hspace*{#1em}\makebox[1em][l]{\textbullet}#2%
  }%
}
% Keep project pairs top-aligned. Split oversized cards into column-width pieces instead of clipping their text.
\newbox\projectleft
\newbox\projectright
\newbox\projectleftpart
\newbox\projectrightpart
\newdimen\projectwidth
\newdimen\projectheight
\newcommand{\projecttile}[1]{%
  % Do not paint an empty partner when the final row is odd or one long card has already finished.
  \ifdim\dimexpr\ht#1+\dp#1\relax>0pt
    % Round only the background; preserve the measured content, padding, and row baseline.
    \tikz[baseline=(projecttile.base)]{%
      \node[fill=projectbackground,rounded corners=4pt,inner sep=\fboxsep,outer sep=0pt] (projecttile) {%
        \vtop to\projectheight{\hrule height0pt width\projectwidth\unvbox#1\vfil}%
      };%
    }%
  \else
    \hbox to\dimexpr\projectwidth+2\fboxsep\relax{\hfil}%
  \fi
}
\newcommand{\projectparts}{%
  % Match tile heights within each row, including the individual pieces of oversized entries.
  \projectheight=\dimexpr\ht\projectleftpart+\dp\projectleftpart\relax
  \ifdim\dimexpr\ht\projectrightpart+\dp\projectrightpart\relax>\projectheight
    \projectheight=\dimexpr\ht\projectrightpart+\dp\projectrightpart\relax
  \fi
  \noindent\hbox to\linewidth{%
    \projecttile\projectleftpart
    \hfil
    \projecttile\projectrightpart
  }\par
}
\newcommand{\printprojectrow}{%
  \projectheight=\dimexpr\ht\projectleft+\dp\projectleft\relax
  \ifdim\dimexpr\ht\projectright+\dp\projectright\relax>\projectheight
    \projectheight=\dimexpr\ht\projectright+\dp\projectright\relax
  \fi
  \ifdim\projectheight>0.85\textheight
    \Needspace{0.9\textheight}%
    \setbox\projectleftpart=\vsplit\projectleft to0.85\textheight
    \setbox\projectrightpart=\vsplit\projectright to0.85\textheight
    \projectparts
    \framebreak
    \printprojectrow
  \else
    \Needspace{\dimexpr\projectheight+2\fboxsep+12pt\relax}%
    \setbox\projectleftpart=\box\projectleft
    \setbox\projectrightpart=\box\projectright
    \projectparts
    \par\addvspace{12pt}%
  \fi
}
\newcommand{\projectrow}[3][]{%
  \begingroup
  % Include the inset inside each existing column's width so backgrounds never consume the gutter.
  \setlength{\fboxsep}{2mm}%
  \projectwidth=\dimexpr0.48\linewidth-2\fboxsep\relax
  \setbox\projectleft=\vbox{\hsize=\projectwidth\linewidth=\projectwidth #2}%
  \setbox\projectright=\vbox{\hsize=\projectwidth\linewidth=\projectwidth #3}%
  % Reserve the measured first row with its heading, including the first chunk of an oversized pair.
  \if\relax\detokenize{#1}\relax\else
    \projectheight=\dimexpr\ht\projectleft+\dp\projectleft\relax
    \ifdim\dimexpr\ht\projectright+\dp\projectright\relax>\projectheight
      \projectheight=\dimexpr\ht\projectright+\dp\projectright\relax
    \fi
    \ifdim\projectheight>0.85\textheight\projectheight=0.85\textheight\fi
    \Needspace{\dimexpr\projectheight+2\fboxsep+5\baselineskip\relax}%
    #1%
  \fi
  \printprojectrow
  \endgroup
}
