% Measure paragraph starts for progression rails. Fixed-column layouts also use the
% measurement to avoid carrying narrow line breaks onto a wider continuation page.
% Apply the same width in measured and printed paragraphs without narrowing headings or figures.
\newcommand{\paragraphcontent}[2]{%
  \begingroup
    \def\currenttextwidthratio{#1}%
    \linespread{\bodylinespread}\selectfont
    \setlength{\rightskip}{\dimexpr\linewidth-#1\linewidth\relax plus1fil}%
    #2\par
  \endgroup
}
\newcommand{\profilesetwidth}{%
  \ifprofilewrapping\ifinner\else%
    \setlength{\linewidth}{\typeblockwidth}%
    \ifnum\value{page}=1\relax%
      \ifdim\pagetotal<\profilecolumnheight\setlength{\linewidth}{0.69\typeblockwidth}\fi%
    \fi%
  \fi\fi%
}%
\newcommand{\profileshape}{%
  \ifprofilebody\ifprofilewrapping\ifdim\hsize=\typeblockwidth%
    \parshape=0\relax%
    \profilesetwidth%
    \addtolength{\linewidth}{-\leftskip}%
    \ifnum\value{page}=1\relax%
      \setlength{\profileremaining}{\dimexpr\profilecolumnheight-\pagetotal\relax}%
      \ifdim\profileremaining>0pt%
        % Limit stretch only beside the profile; full-width figures must retain their own centering glue.
        \rightskip=0pt plus2em\relax%
        % Reserve only the lines whose tops overlap the measured profile, including a fractional final line.
        \profilenarrowlines=\profileremaining\relax%
        \divide\profilenarrowlines by\baselineskip\relax%
        \advance\profilenarrowlines by1\relax%
        \edef\profileshapespec{\the\numexpr\profilenarrowlines+1\relax}%
        \profileshapeline=1\relax%
        \loop%
          \ifnum\profileshapeline>\profilenarrowlines%
            \setlength{\profilelinewidth}{\typeblockwidth}%
          \else%
            \setlength{\profilelinewidth}{0.69\typeblockwidth}%
          \fi%
          % Explicit shapes supersede TeX's hanging indentation; preserve each bullet's continuation indent.
          \setlength{\profilelineindent}{0pt}%
          \ifnum\profileshapeline>\hangafter%
            \setlength{\profilelineindent}{\hangindent}%
          \fi%
          \addtolength{\profilelinewidth}{-\profilelineindent}%
          % Scale each line's available content width, including lines that widen below the profile.
          % TeX applies leftskip separately; keep progression-rail indentation outside the ratio.
          \addtolength{\profilelinewidth}{-\leftskip}%
          \setlength{\profilelinewidth}{\currenttextwidthratio\profilelinewidth}%
          \addtolength{\profilelinewidth}{\leftskip}%
          \edef\profileshapespec{\profileshapespec\space\the\profilelineindent\space\the\profilelinewidth}%
          \advance\profileshapeline by1\relax%
        \ifnum\profileshapeline<\numexpr\profilenarrowlines+2\relax\repeat%
        \expandafter\parshape\profileshapespec\relax%
      \fi%
    \fi%
  \fi\fi\fi%
}%
% Heading sizes and optional profile fields change vertical positions; recompute the exclusion at every body paragraph.
\AddToHook{para/begin}{\profileshape\profileparagraphmark}%
\newcommand{\profilefullwidth}{%
  \par%
  \ifprofilewrapping%
    \ifnum\value{page}=1\relax%
      \ifdim\pagetotal<\profilecolumnheight%
        \vspace*{\dimexpr\profilecolumnheight-\pagetotal\relax}%
      \fi%
    \fi%
    \setlength{\linewidth}{\typeblockwidth}%
  \else%
    \ifnum\value{page}=1\clearpage\fi%
  \fi%
}%
\newcommand{\profileparagraph}[2][\bodytextwidthratio]{%
  \par
  \profilesetwidth
  \setlength{\profileparagraphwidth}{\linewidth}%
  \ifprofileprogression\addtolength{\profileparagraphwidth}{\dimexpr-6mm-0.6pt\relax}\fi
  \sbox{\paragraphmeasure}{\parbox[t]{\profileparagraphwidth}{\paragraphcontent{#1}{#2}}}%
  % Fixed columns and headers too tall to wrap remeasure paragraphs when moving to a wider continuation page.
  \ifprofilewrapping\else
    \ifdim\dimexpr\ht\paragraphmeasure+\dp\paragraphmeasure+\parskip+\baselineskip\relax<\typeblockheight
      \ifdim\dimexpr\ht\paragraphmeasure+\dp\paragraphmeasure+\parskip+\baselineskip\relax>\dimexpr\pagegoal-\pagetotal\relax
        \framebreak
        % Flowfram resumes in horizontal mode; start a fresh paragraph so its hook places the new page's rail anchor.
        \par
        \setlength{\profileparagraphwidth}{\linewidth}%
        \ifprofileprogression\addtolength{\profileparagraphwidth}{\dimexpr-6mm-0.6pt\relax}\fi
        \sbox{\paragraphmeasure}{\parbox[t]{\profileparagraphwidth}{\paragraphcontent{#1}{#2}}}%
      \fi
    \fi
  \fi
  % Text stays in one frame: a paragraph can widen below the profile without leaving a paragraph-sized gap.
  \ifprofileprogression
    \stepcounter{profileparagraphid}%
    \begingroup
      \setlength{\leftskip}{\dimexpr6mm+0.6pt\relax}%
      \setlength{\linewidth}{\profileparagraphwidth}%
      % Start the rail after bullet indentation has been set, without starting its paragraph prematurely.
      \def\profileparagraphmark{%
        \let\profileparagraphmark\relax
        \tikz[remember picture,overlay]{%
          \coordinate (role-start-\arabic{profileparagraphid}) at (-3mm-0.3pt,\ht\paragraphmeasure);
        }%
      }%
      \paragraphcontent{#1}{#2}%
    \endgroup
    % A zero-height mark records the paragraph's bottom without changing its baseline spacing.
    \profileraildepth=\prevdepth
    \nointerlineskip\hbox{\tikz[remember picture,overlay]{%
      \coordinate (role-end-\arabic{profileparagraphid}) at (3mm+0.3pt,0pt);
    }}%
    \prevdepth=\profileraildepth
    \edef\profilerailstart{role-start-\arabic{profileparagraphid}}%
    \ifnum\profilerailpage=\value{page}\relax
      \edef\profilerailstart{\profilerailprevious}%
    \fi
    % Freeze node identifiers before the shipout hook runs; vertices stay visible above these background rails.
    \edef\pendingprofilerail{\noexpand\AddToHookNext{shipout/background}{%
      \noexpand\drawprofilerail{\profilerailstart}{role-end-\arabic{profileparagraphid}}%
        {\profilerailopacity}{\the\dimexpr0.5\baselineskip\relax}}}%
    \pendingprofilerail
    \edef\profilerailprevious{role-end-\arabic{profileparagraphid}}%
    \profilerailpage=\value{page}
    \def\profilerailopacity{100}%
  \else
    \paragraphcontent{#1}{#2}%
  \fi
}
