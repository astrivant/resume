{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Suggested LinkedIn profile skills",
  "type": "object",
  "additionalProperties": false,
  "required": ["username", "source_tag", "source_digest", "skills"],
  "properties": {
    "username": {"type": "string"},
    "source_tag": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "skills": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\r\\n\\t]+$"},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}
