% A left rule connects roles within a company and continues on subsequent pages without boxing the whole history.
\newenvironment{roleprogression}{%
  % Framed centers continuation pieces by default; keep the bar at the left when the next flow frame is wider.
  \let\centerline\leftline
  \def\FrameCommand##1{\hspace{3mm}{\color{ink!25}\vrule width0.6pt}\hspace{3mm}##1}%
  \MakeFramed{\advance\hsize-\width\FrameRestore}%
}{\endMakeFramed}
% Scale to cover the circle without stretching, then clip only the portrait in the PDF.
% Original captured images stay untouched, and logos retain their rectangular outlines.
\newsavebox{\portraitmeasure}
\newlength{\portraitdiameter}
\newcommand{\portraitphoto}[2][36.4mm]{%
  \begingroup
  \setlength{\portraitdiameter}{#1}%
  \sbox{\portraitmeasure}{\includegraphics[width=\portraitdiameter]{#2}}%
  \ifdim\ht\portraitmeasure<\portraitdiameter
    \sbox{\portraitmeasure}{\includegraphics[height=\portraitdiameter]{#2}}%
  \fi
  \begin{tikzpicture}
    \path[use as bounding box] (-0.5\portraitdiameter,-0.5\portraitdiameter)
      rectangle (0.5\portraitdiameter,0.5\portraitdiameter);
    \clip (0,0) circle[radius=0.5\portraitdiameter];
    \node[overlay,inner sep=0pt,outer sep=0pt] at (0,0) {\usebox{\portraitmeasure}};
  \end{tikzpicture}%
  \endgroup
}
% Finish ordinary first-page paragraphs before switching frame widths. Without this
% measurement TeX would carry their narrow line breaks onto the full-width second page.
% Paragraphs longer than a whole page remain breakable, so no profile text is clipped.
\newsavebox{\paragraphmeasure}
\newcommand{\profileparagraph}[1]{%
  \par
  \ifnum\value{page}=1
    \sbox{\paragraphmeasure}{\parbox{\linewidth}{#1}}%
    % Include leading baseline space; underestimating it can overflow before framebreak and flush a second, nearly empty page.
    \ifdim\dimexpr\ht\paragraphmeasure+\dp\paragraphmeasure+\parskip+\baselineskip\relax<\textheight
      \ifdim\dimexpr\ht\paragraphmeasure+\dp\paragraphmeasure+\parskip+\baselineskip\relax>\dimexpr\pagegoal-\pagetotal\relax
        \framebreak
      \fi
    \fi
  \fi
  #1\par
}
% Keep a company's linked logo beside its name, allowing long employer names to wrap within the remaining width.
\newcommand{\companyline}[2]{%
  \profileparagraph{%
    \begin{minipage}[c]{8mm}\centering #1\end{minipage}%
    \hspace{2mm}%
    \begin{minipage}[c]{\dimexpr\linewidth-10mm\relax}\raggedright #2\end{minipage}%
  }%
}
% Project affiliation logos share the surrounding text's scale and keep their natural aspect ratio.
\newcommand{\inlinecompanylogo}[1]{%
  \raisebox{-0.15em}{\includegraphics[width=1.1em,height=1.1em,keepaspectratio]{#1}}%
}
% Normalize every recognized marker to one print bullet, with hanging alignment for wrapped and nested items.
% Each item remains a paragraph so it can use the existing flow-frame pagination and width measurements.
\newcommand{\profilebullet}[2]{%
  % TeX resets hanging indentation after the paragraph; leave flow-frame changes outside a temporary formatting group.
  \profileparagraph{%
    \hangindent=\dimexpr#1em+1em\relax\hangafter=1
    \noindent\hspace*{#1em}\makebox[1em][l]{\textbullet}#2%
  }%
}
% Keep project pairs top-aligned. Split oversized cards into column-width pieces instead of clipping their text.
\newbox\projectleft
\newbox\projectright
\newbox\projectleftpart
\newbox\projectrightpart
\newdimen\projectwidth
\newdimen\projectheight
\newcommand{\projectparts}{%
  \noindent\hbox to\linewidth{%
    \vtop{\hrule height0pt width\projectwidth\unvbox\projectleftpart}%
    \hfil
    \vtop{\hrule height0pt width\projectwidth\unvbox\projectrightpart}%
  }\par
}
\newcommand{\printprojectrow}{%
  \projectheight=\dimexpr\ht\projectleft+\dp\projectleft\relax
  \ifdim\dimexpr\ht\projectright+\dp\projectright\relax>\projectheight
    \projectheight=\dimexpr\ht\projectright+\dp\projectright\relax
  \fi
  \ifdim\projectheight>0.85\textheight
    \Needspace{0.9\textheight}%
    \setbox\projectleftpart=\vsplit\projectleft to0.85\textheight
    \setbox\projectrightpart=\vsplit\projectright to0.85\textheight
    \projectparts
    \framebreak
    \printprojectrow
  \else
    \Needspace{\dimexpr\projectheight+12pt\relax}%
    \setbox\projectleftpart=\box\projectleft
    \setbox\projectrightpart=\box\projectright
    \projectparts
    \par\addvspace{12pt}%
  \fi
}
\newcommand{\projectrow}[3][]{%
  \begingroup
  \projectwidth=0.48\linewidth
  \setbox\projectleft=\vbox{\hsize=\projectwidth\linewidth=\projectwidth #2}%
  \setbox\projectright=\vbox{\hsize=\projectwidth\linewidth=\projectwidth #3}%
  % Reserve the measured first row with its heading, including the first chunk of an oversized pair.
  \if\relax\detokenize{#1}\relax\else
    \projectheight=\dimexpr\ht\projectleft+\dp\projectleft\relax
    \ifdim\dimexpr\ht\projectright+\dp\projectright\relax>\projectheight
      \projectheight=\dimexpr\ht\projectright+\dp\projectright\relax
    \fi
    \ifdim\projectheight>0.85\textheight\projectheight=0.85\textheight\fi
    \Needspace{\dimexpr\projectheight+5\baselineskip\relax}%
    #1%
  \fi
  \printprojectrow
  \endgroup
}
