% Limit theme colors to their semantic roles; groups prevent heading colors leaking into body text.
\newcommand{\entrytitle}[1]{{\color{entryheading}\large\bfseries #1}\par\nopagebreak}
\newcommand{\roletitle}[1]{{\color{entryheading}\normalsize\bfseries #1}\par\nopagebreak}
