((# Shared entry rendering keeps project cards and ordinary sections on the same escaping and image rules. #))
((* macro render_text(paragraphs, links, locations={}, affiliations={}, badges={}) *))
((* for block in paragraphs|text_blocks *))
((* if block.depth is not none *))
\profilebullet{((( block.depth )))}{((( block.text|tex_links(links) )))}
((* else *))
((* if block.text in badges *))
((( company_name((0, badges[block.text]), block.text, links) )))
((* elif block.text in affiliations *))
((* set prefix, company, logo = affiliations[block.text] *))
\profileparagraph{((( prefix|tex )))%
((* if logo.link *))\href{((( logo.link|url )))}{((* endif *))\inlinecompanylogo{((( logo.path )))}((* if logo.link *))}((* endif *))%
\nobreak\hspace{0.3em}((( company|tex )))}
((* elif block.text in locations *))
((* set location = locations[block.text] *))
\profileparagraph{\href{((( location.url|url )))}{((( location.label|tex )))}((( block.text[location.label|length:]|tex_links(links) )))}
((* else *))
\profileparagraph{((( block.text|tex_links(links) )))}
((* endif *))
((* endif *))
((* endfor *))
((* endmacro *))
((* macro company_name(badge, text, links, heading=false) *))
\companyline{%
((* if badge[1].link *))\href{((( badge[1].link|url )))}{((* endif *))%
\includegraphics[width=8mm,height=8mm,keepaspectratio]{((( badge[1].path )))}%
((* if badge[1].link *))}((* endif *))%
}{((* if heading *))\entrytitle{((* endif *))((( text|tex_links(links) )))((* if heading *))}((* endif *))}
((* endmacro *))
((* macro render_entry(entry, section, role=false, parent_title=none) *))
((* set entry = entry|experience_layout if section.key == 'experience' else entry *))
((* set text_links = entry.links *))
((# Deduplicate only the immediate child heading; all paragraphs, illustrations, and references remain renderable. #))
((* set heading = entry.title|distinct_heading(parent_title if parent_title is not none else section.title) *))
((* set project = entry|project_layout(show_title=heading != '') if section.key == 'projects' else none *))
((* set entry = project.entry if project else entry *))
((* set badge = entry|employer_badge if section.key == 'experience' else none *))
((# A logo attached to a suppressed company heading falls back to the gallery so it and its link remain visible. #))
((* if not heading and badge and badge[0] == -1 *))((* set badge = none *))((* endif *))
((* set locations = entry|job_locations if section.key == 'experience' else {} *))
((* if section.key == 'about' *))
((( render_text([heading], entry.links) )))
((* elif heading *))
((# Keep a company with its first role, and short jobs with their descriptions, when reflow approaches a page boundary. #))
\Needspace{((* if entry.positions or (badge and entry.paragraphs|length <= 5) *))12((* elif section.key == 'education' *))8((* elif badge *))6((* else *))3((* endif *))\baselineskip}
((* if badge and badge[0] == -1 *))
((( company_name(badge, heading, entry.links, heading=true) )))
((* elif project and project.title_url *))
\entrytitle{\href{((( project.title_url|url )))}{((( heading|tex )))}}
((* elif role *))
\roletitle{((( heading|tex_links(entry.links) )))}
((* else *))
\entrytitle{((( heading|tex_links(entry.links) )))}
((* endif *))
((* endif *))
((* if project *))
((( render_text(project.metadata, text_links, affiliations=project.affiliations) )))
((* elif badge and badge[0] == 0 *))
((( company_name(badge, entry.paragraphs[0], entry.links) )))
((( render_text(entry.paragraphs[1:], entry.links, locations) )))
((* else *))
((( render_text(entry.paragraphs, text_links, locations, project.affiliations if project else {}) )))
((* endif *))
((# Match the source hierarchy: featured illustrations, compact attachments, organization logos, then tiny site icons. #))
((* set gallery = entry.images|reject('equalto', badge[1])|list if badge else entry.images *))
((* if gallery *))\profileparagraph{((* endif *))
((* for image in gallery -*))
((* set role = image|image_role -*))
((* if image.link *))\href{((( image.link|url )))}{((* endif *))%
((* if role == 'portrait' -*))
\portraitphoto[8mm]{((( image.path )))}%
((* elif role == 'icon' -*))
\includegraphics[width=3.5mm,height=3.5mm,keepaspectratio]{((( image.path )))}%
((* elif role == 'logo' -*))
\includegraphics[width=8mm,height=8mm,keepaspectratio]{((( image.path )))}%
((* elif section.key in ['featured', 'activity'] -*))
\includegraphics[width=0.8\linewidth,height=40mm,keepaspectratio]{((( image.path )))}%
((* else -*))
\includegraphics[width=24mm,height=14mm,keepaspectratio]{((( image.path )))}%
((* endif -*))
((* if image.link *))}((* endif *))\hspace{3pt}
((* endfor -*))
((* if gallery *))}((* endif *))
((# Attachment descriptions travel with the project and explain its media from directly underneath it. #))
((* if project *))
((( render_text(project.description, text_links) )))
((* endif *))
((# The employer badge already links its destination; retain a text reference only when no linked badge supplies it. #))
((* for link in entry.links if not badge or not badge[1].link or (link.resolved_url or link.url) != badge[1].link *))
((* if link.label == link.url and not link.title *))
\profileparagraph{{\small ((( link.label|tex_links([link]) )))}}
((* else *))
\profileparagraph{{\small\href{((( (link.resolved_url or link.url)|url )))}{((( (link.title if link.label == link.url else link.label)|tex )))}}}
((* endif *))
((* endfor *))
((# Roles retain their own dates, locations, and descriptions inside one breakable company progression. #))
((* if entry.positions *))
\begin{roleprogression}
((* for position in entry.positions *))
((* if not loop.first *))\par\addvspace{9pt}((* endif *))
((( render_entry(position, section, role=true, parent_title=entry.title) )))
((* endfor *))
\end{roleprogression}
((* endif *))
((* endmacro *))
((* macro section_heading(section, anchor) *))
((# Emit each destination with the heading after pagination has selected its final page. #))
\hypertarget{((( anchor )))}{}%
\sectiontitle{((( section.title|tex )))}
((* endmacro *))
((* macro render_section(section, anchor) *))
((* if section.key == 'projects' *))
% Projects use the full paper width; move past the first-page identity columns only when necessary.
\ifnum\value{page}=1\clearpage\fi
((* endif *))
((# Reserve the first education entry's eight lines plus its section heading so reflow cannot strand the heading. #))
\Needspace{((* if section.key == 'education' *))11((* else *))5((* endif *))\baselineskip}
((* if section.key == 'skills' and skill_cloud *))\begin{minipage}{\linewidth}((* endif *))
((* if section.key != 'projects' *))((( section_heading(section, anchor) )))((* endif *))
((* if section.key == 'skills' and skill_cloud *))
% Scale both bounds to 75% of the original display size without changing the cloud's proportions or weights.
\includegraphics[width=0.75\linewidth,height=0.4125\textheight,keepaspectratio]{((( skill_cloud )))}\par
((* if style.skill_colors|length > 1 *))
{\footnotesize Endorsements: \textcolor{skilllow}{0\%}\enspace--\enspace\textcolor{skillhigh}{100\% of highest count}}\par
((* endif *))
\end{minipage}
((* elif section.key == 'projects' *))
((* for pair in section.entries|batch(2) *))
\projectrow[((* if loop.first *))((( section_heading(section, anchor) )))((* endif *))]{((( render_entry(pair[0], section) )))}{((* if pair|length == 2 *))((( render_entry(pair[1], section) )))((* endif *))}
((* endfor *))
((* else *))
((* for entry in section.entries *))
((* if not loop.first *))\par\addvspace{9pt}((* endif *))
((( render_entry(entry, section) )))
((* endfor *))
((* endif *))
\par\addvspace{10pt}
((* endmacro *))
