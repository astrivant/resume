{\fontsize{24}{28}\selectfont\bfseries ((( profile.name|tex )))}\par\vspace{6pt}
((* for image in profile.images *))
((* if image is header_photo *))
\includegraphics[width=\linewidth]{((( image.path )))}\par
((* else *))
\includegraphics[width=22mm,height=28mm,keepaspectratio]{((( image.path )))}\par
((* endif *))
((* endfor *))
((* for line in profile.intro *))
((( line|tex )))\par
((* endfor *))
\href{https://www.linkedin.com/in/((( profile.username|url )))/}{\textbf{LinkedIn profile}}\par
((* for link in profile.links *))
((* if link.label == link.url *))
\url{((( link.url )))}\par
((* else *))
\href{((( link.url|url )))}{((( link.label|tex )))}\par
((* endif *))
((* endfor *))
\par\addvspace{12pt}
((* for section in profile.sections if section.key == 'contact' *))
((( render_section(section) )))
((* endfor *))
((# A header-only profile does not need a forced break or an empty body heading. #))
((* set body = profile.sections|rejectattr('key', 'equalto', 'contact')|list *))
((* if body *))
\framebreak
