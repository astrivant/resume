((# Shared entry rendering keeps project cards and ordinary sections on the same escaping and image rules. #))
((* macro render_entry(entry, section) *))
((* if section.key == 'about' *))
\profileparagraph{((( entry.title|tex_links(entry.links) )))}
((* else *))
\Needspace{((* if section.key == 'education' *))8((* else *))3((* endif *))\baselineskip}
\entrytitle{((( entry.title|tex_links(entry.links) )))}
((* endif *))
((* for paragraph in entry.paragraphs *))
\profileparagraph{((( paragraph|tex_links(entry.links) )))}
((* endfor *))
((# Match the source hierarchy: featured illustrations, compact attachments, organization logos, then tiny site icons. #))
((* if entry.images *))\profileparagraph{((* endif *))
((* for image in entry.images -*))
((* set role = image|image_role -*))
((* if image.link *))\href{((( image.link|url )))}{((* endif *))%
((* if role == 'portrait' -*))
\portraitphoto[8mm]{((( image.path )))}%
((* elif role == 'icon' -*))
\includegraphics[width=3.5mm,height=3.5mm,keepaspectratio]{((( image.path )))}%
((* elif role == 'logo' -*))
\includegraphics[width=8mm,height=8mm,keepaspectratio]{((( image.path )))}%
((* elif section.key in ['featured', 'activity'] -*))
\includegraphics[width=0.8\linewidth,height=40mm,keepaspectratio]{((( image.path )))}%
((* else -*))
\includegraphics[width=24mm,height=14mm,keepaspectratio]{((( image.path )))}%
((* endif -*))
((* if image.link *))}((* endif *))\hspace{3pt}
((* endfor -*))
((* if entry.images *))}((* endif *))
((* for link in entry.links *))
((* if link.label == link.url and not link.title *))
\profileparagraph{{\small ((( link.label|tex_links([link]) )))}}
((* else *))
\profileparagraph{{\small\href{((( (link.resolved_url or link.url)|url )))}{((( (link.title if link.label == link.url else link.label)|tex )))}}}
((* endif *))
((* endfor *))
((* endmacro *))
((* macro render_section(section) *))
((* if section.key == 'projects' *))
% Projects use the full paper width; move past the first-page identity columns only when necessary.
\ifnum\value{page}=1\clearpage\fi
((* endif *))
\Needspace{5\baselineskip}
((* if section.key == 'skills' and skill_cloud *))\begin{minipage}{\linewidth}((* endif *))
((* if section.key != 'projects' *))\sectiontitle{((( section.title|tex )))}((* endif *))
((* if section.key == 'skills' and skill_cloud *))
\includegraphics[width=\linewidth,height=0.55\textheight,keepaspectratio]{((( skill_cloud )))}\par
\end{minipage}
((* elif section.key == 'projects' *))
((* for pair in section.entries|batch(2) *))
\projectrow[((* if loop.first *))\sectiontitle{((( section.title|tex )))}((* endif *))]{((( render_entry(pair[0], section) )))}{((* if pair|length == 2 *))((( render_entry(pair[1], section) )))((* endif *))}
((* endfor *))
((* else *))
((* for entry in section.entries *))
((* if not loop.first *))\par\addvspace{9pt}((* endif *))
((( render_entry(entry, section) )))
((* endfor *))
((* endif *))
\par\addvspace{10pt}
((* endmacro *))
